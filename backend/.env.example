APP_NAME="Portfolio API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8100

# Origin of the Next.js site: CORS allow-list and revalidation webhook target.
FRONTEND_URL=http://localhost:3100

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# Where uploads are stored. Local dev: public + local (storage/app). A container host with an
# ephemeral disk (Render, Koyeb) needs object storage: MEDIA_DISK=s3, MEDIA_ORIGINALS_DISK=s3-private.
MEDIA_DISK=public
MEDIA_ORIGINALS_DISK=local
# S3-compatible storage (e.g. Cloudflare R2), used only by the s3 / s3-private disks.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_BUCKET=portfolio-media
# AWS_PRIVATE_BUCKET=portfolio-originals
# Public base URL of AWS_BUCKET (R2: the r2.dev URL or a custom domain), no trailing slash.
# AWS_URL=https://media.example.com

# Behind a platform load balancer: * (trust the direct caller) so throttles see the real client IP.
# TRUSTED_PROXIES=*

# Admin access tokens (Sanctum personal access tokens), lifetime in minutes (10080 = 7 days).
SANCTUM_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=hk_

# The single admin account, created/updated by `php artisan db:seed` (AdminUserSeeder).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Shared secret with the frontend's REVALIDATE_SECRET.
REVALIDATE_SECRET=change-me-to-a-long-random-string
# Optional: seconds the revalidation webhook may take (default 10).
# REVALIDATE_TIMEOUT=10

# Optional: contact-form notifications are mailed to ADMIN_EMAIL when a real mailer is configured.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
