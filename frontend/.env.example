# Public origin of this site (metadata, sitemap, OG images).
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Laravel API base URL, server-only (used by Server Components and the admin proxy).
API_URL=http://127.0.0.1:8100/api/v1

# Same API, reachable from the browser: only the three public POSTs (view, defeat, contact) use it,
# so the backend's per-IP throttles see the visitor's real IP.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8100/api/v1

# Shared secret with the backend's REVALIDATE_SECRET (POST /api/revalidate).
REVALIDATE_SECRET=change-me-to-a-long-random-string

# Production only, when uploads live in object storage (backend MEDIA_DISK=s3): the bucket's public
# base URL, same as the backend's AWS_URL. Lets next/image optimise those images.
# MEDIA_URL=https://media.example.com
